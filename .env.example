# Copy to .env (which is gitignored) and fill in. A real environment variable
# always wins over this file, so deployed secrets are never shadowed by it.

# --- required to connect Google -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public origin of this app. The OAuth redirect URI is derived from it as
# $VITALS_BASE_URL/auth/callback, and that exact string must also be listed on the
# OAuth client in Google Cloud — a mismatch is a redirect_uri_mismatch error, not a
# silent failure, so it is easy to spot but impossible to work around.
VITALS_BASE_URL=http://localhost:4330

# --- optional --------------------------------------------------------------
# PORT=4330
# HOST=127.0.0.1
# STATE_DIR=./state

# How far back to backfill, and how aggressively to poll.
# VITALS_BACKFILL_DAYS=365
# VITALS_TAIL_INTERVAL_SEC=300

# Webhooks (near-real-time). Needs a PUBLIC https endpoint — Google verifies it
# during subscriber registration, so localhost cannot be used.
# GOOGLE_PROJECT_NUMBER=
# VITALS_WEBHOOK_SECRET=
