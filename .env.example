# Copy to .env (which is gitignored) and fill in. A real environment variable
# always wins over this file, so deployed secrets are never shadowed by it.

# --- required to connect Google -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public origin of this app. The OAuth redirect URI is derived from it as
# $VITALS_BASE_URL/auth/callback, and that exact string must also be listed on the
# OAuth client in Google Cloud — a mismatch is a redirect_uri_mismatch error, not a
# silent failure, so it is easy to spot but impossible to work around.
VITALS_BASE_URL=http://localhost:4330

# --- database ---------------------------------------------------------------
# The shared MySQL store. Local dev tunnels to the fleet DB (see CLAUDE.md):
#   ssh -f -N -L 3307:<db-host>:3306 <db-server>
# and then points MYSQL_PORT at 3307.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vitals
MYSQL_PASSWORD=
MYSQL_DATABASE=vitals

# --- optional --------------------------------------------------------------
# PORT=4330
# HOST=127.0.0.1

# The house timezone offset in minutes east of UTC (default 240 = UTC+4). Used
# as the civil-day default whenever a request does not carry ?tz=.
# VITALS_TZ_OFFSET_MIN=240

# How far back to backfill, and how aggressively to poll.
# VITALS_BACKFILL_DAYS=365
# VITALS_TAIL_INTERVAL_SEC=300
# VITALS_TAIL_OVERLAP_HOURS=36
# VITALS_LEASE_TTL_SEC=600
# VITALS_RATE_PER_MIN=240
# VITALS_PAGE_SIZE=5000

# Webhooks (near-real-time). Needs a PUBLIC https endpoint — Google verifies it
# during subscriber registration, so localhost cannot be used.
# GOOGLE_PROJECT_NUMBER=
# VITALS_WEBHOOK_SECRET=
# VITALS_WEBHOOK_REQUIRE_SIGNATURE=1

# Demo mode: load synthetic data at startup (never into a connected account).
# VITALS_DEMO=1
# VITALS_DEMO_DAYS=180

# Tests: the DB-backed tests use a separate database that gets truncated.
# VITALS_TEST_DATABASE=vitals_test
